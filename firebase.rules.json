{
  "rules": {
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'",
      "admin": {
        ".read": "auth != null && auth.token.role === 'admin'",
        ".write": "auth != null && auth.token.role === 'admin'"
      },
      "deviceAccessAutoApprove": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    },
    "employees": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'",
      ".indexOn": ["empId"],
      "$empId": {
        "pin": {
          ".read": false,
          ".write": "auth != null && auth.token.role === 'admin'"
        }
      }
    },
    "logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$month": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$logId": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.token.role === 'admin' || (!data.exists() && newData.child('empId').val() === auth.token.empId))"
        }
      }
    },
    "leaves": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$leaveId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'admin' || (!data.exists() && newData.child('empId').val() === auth.token.empId))"
      }
    },
    "fuel_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'admin' || (!data.exists() && newData.child('empId').val() === auth.token.empId))"
      }
    },
    "device_access": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$deviceId": {
        ".read": "auth != null && (auth.token.role === 'admin' || data.child('empId').val() === auth.token.empId || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && (auth.token.role === 'admin' || !data.exists() || data.child('empId').val() === auth.token.empId)"
      }
    },
    "delivery_jobs": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$date": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$jobId": {
          ".read": "auth != null && (auth.token.role === 'admin' || data.child('driverId').val() === auth.token.empId)",
          ".write": "auth != null && (auth.token.role === 'admin' || newData.child('driverId').val() === auth.token.empId)"
        }
      }
    },
    "customers": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "foam_customers": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$customerId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'admin' || !data.exists())"
      }
    },
    "foam_delivery_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$date": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$requestId": {
          ".read": "auth != null && (auth.token.role === 'admin' || data.child('employeeId').val() === auth.token.empId)",
          ".write": "auth != null && (auth.token.role === 'admin' || (!data.exists() && newData.child('employeeId').val() === auth.token.empId) || data.child('employeeId').val() === auth.token.empId)"
        }
      }
    },
    "routes_preset": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "locations": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "car_plates": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "holidays": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "login_attempts": {
      ".read": false,
      ".write": false
    },
    "session_tokens": {
      ".read": false,
      ".write": false
    }
  }
}